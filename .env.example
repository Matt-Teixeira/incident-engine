# incident-engine — copy to .env and fill in. .env is gitignored; never commit
# secret values. Variable rules: markdown/ENVIRONMENT.md.

# --- Identity / logging ---
APP_NAME=incident-engine
# USER_ID drives the image tag (incident-engine:${USER_ID}) and the build LABEL.
# Dev = your host username; the release copy gets svc via the #RELEASE: line,
# applied by build-release.sh to the DEPLOYED .env only.
USER_ID=         # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc
# Host identity for the image build (per-server — read from THIS host):
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u jonathan-pope
UID_2=           # REQUIRED: id -u matt-teixeira
# RUN_USER: do NOT set here. docker/entrypoint.sh defaults it to svc; dev runs
# pass it on the command line: RUN_USER=<you> docker compose run --rm app ...
# log = file only; log_and_console adds error stacks + first/last event stats
LOGGER_MODE=log_and_console
#RELEASE:LOGGER_MODE=log
# Host side of the run-log mount. Unset/dev = in-tree (gitignored); the
# release copy gets the central svc-owned dir via the #RELEASE: line.
LOG_DIR=./utils/logger/logs
#RELEASE:LOG_DIR=/opt/run-logs/incident-engine
# (LOGGER, RUN_ENV and RUN_LOGS_DIR are RETIRED — the compose LOG_DIR mount
# decides where logs land, and the filename tag is USER_ID.)

# --- PostgreSQL (least-privilege owner of the incidents schema) ---
PGHOST=pg_db
PGPORT=5432
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PGUSER=incident_engine_rw
PGPASSWORD=change-me
# verify-full = CA + hostname verification (fail-closed if the CA is missing).
# `require` (encrypted, unauthenticated) is a documented exception, not a default.
PG_SSLMODE=verify-full
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# --- Pipeline (defaults; consumed from Phase 2 on) ---
ASSESSOR_KIND=rules
# MATERIALIZE_OVERLAP_MS=30000
# MATERIALIZE_BATCH_ROWS=5000
# ASSESS_WINDOW_HOURS=24
